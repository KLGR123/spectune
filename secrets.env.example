# NMRexp raw-data dir, dataset/output dirs, and classifier worker count are
# per-run choices, not env vars: pass --raw-dir/--datasets-dir/--output-dir/
# --workers explicitly on the relevant CLI entry points (spectune.dataloader,
# spectune.augmentor, spectune.classifier) instead of baking them in here.

export SPECTUNE_LLM_BASE_URL=https://api.gpugeek.com/v1
export SPECTUNE_LLM_API_KEY=
export SPECTUNE_LLM_MODEL=GPT-5.4

export LITELLM_API_KEY=sk-CHx037W4BYMQuhNbXrl4Og
export LITELLM_API_BASE=https://ai-gateway-global.dp.tech
export LITELLM_MODEL=openai/specmaster/gpt-5.5

# Which chat-completion backend spectune.llm.create_llm_client() builds by
# default: "http" (SPECTUNE_LLM_* above) or "litellm" (LITELLM_* above).
# `python -m spectune.rollout --backend litellm` overrides this per-run.
export SPECTUNE_LLM_BACKEND=http

export SPECTUNE_REACTION_SCAN_WORKERS=16

# `--backend local` (python -m spectune.rollout / spectune.rollout.eval) has no
# env var: pass --model /path/to/weights [--tensor-parallel-size N] explicitly
# on the command line every time you launch a local vLLM server.

# git clone https://github.com/ChemFoundationModels/ChemLLMBench.git for all data
# git clone https://huggingface.co/datasets/jablonkagroup/chempile-lift for all data (> 18 GB)

export RXN_LOCAL_INDEX_USPTO_CSV=/path/to/data/reaction_prediction/uspto_test.csv
export RXN_LOCAL_INDEX_CHEMPILE_PARQUET=/path/to/data/train-00000-of-00001.parquet
export RXN_LOCAL_INDEX_PISTACHIO_SMI=/path/to/data/pistachio.smi

# askcos_reaction_forward_predict calls the public https://askcos.mit.edu API by default; no credentials needed.
# export ASKCOS_PUBLIC_BASE_URL=     

# unimol3_reaction_forward_predict; unset by default
# export UNIMOL3_REACTION_FORWARD_PREDICT_API_URL=     

# semantic_scholar_search / crossref_search / wikipedia_search need no credentials.
# export SEMANTIC_SCHOLAR_API_KEY=       # optional, raises Semantic Scholar rate limits         
# export CROSSREF_MAILTO=                # optional, joins Crossref's "polite pool"
# export WIKIPEDIA_LANGUAGE=             # optional, defaults to "en"

# Tool result disk cache (spectune.tools.CachedToolManager)
export SPECTUNE_TOOL_CACHE_DIR=/path/to/spectune/cache
export SPECTUNE_TOOL_CACHE_MAX_SIZE=10000